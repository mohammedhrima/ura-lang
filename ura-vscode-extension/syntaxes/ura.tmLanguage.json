{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ura",
  "scopeName": "source.ura",
  "comment": "Keep these word lists in sync with the tokenizer in src/main.c (keywords and specials tables).",
  "patterns": [
    { "include": "#comments" },
    { "include": "#function-definition" },
    { "include": "#control" },
    { "include": "#types" },
    { "include": "#pointers" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ura",
          "match": "//.*$"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.ura" },
            "2": { "name": "entity.name.function.ura" }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.ura",
          "match": "\\b(if|elif|else|while|break|continue|return)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.ura",
          "match": "\\b(i32|b1)\\b"
        },
        {
          "name": "storage.type.ref.ura",
          "match": "\\bref\\b"
        }
      ]
    },
    "pointers": {
      "patterns": [
        {
          "name": "keyword.operator.pointer.ura",
          "match": "\\b(own|dref)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.ura",
          "match": "\\b(True|False)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.ura",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.ura" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ura",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.ura",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.ura",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.ura",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.ura",
          "match": ","
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.ura",
          "match": "\\b[A-Za-z_]\\w*\\b"
        }
      ]
    }
  }
}
