use "@/math"
use "@/stdlib"
use "@/io"
use "@/memory"
use "@/sdl2"

WIDTH i32 = 400
HEIGHT i32 = 400
MAX_BOUNCES i32 = 5
HIT_EPSILON f64 = 0.001
FAR f64 = 1000000000.0
PARALLEL_EPSILON f64 = 0.00000001
PI f64 = 3.14159265358979
CAMERA_STEP f64 = 0.5

DIFFUSE i32 = 0
MIRROR i32 = 1
GLASS i32 = 2

SPHERE i32 = 0
PLANE i32 = 1
TRIANGLE i32 = 2
RECTANGLE i32 = 3
CYLINDER i32 = 4
CONE i32 = 5

struct Vec3:
    x f64
    y f64
    z f64

    operator +(o &Vec3) Vec3:
        return {x: self.x + o.x, y: self.y + o.y, z: self.z + o.z}

    operator -(o &Vec3) Vec3:
        return {x: self.x - o.x, y: self.y - o.y, z: self.z - o.z}

    operator *(o &Vec3) Vec3:
        return {x: self.x * o.x, y: self.y * o.y, z: self.z * o.z}

    operator *(t f64) Vec3:
        return {x: self.x * t, y: self.y * t, z: self.z * t}

    operator /(t f64) Vec3:
        return {x: self.x / t, y: self.y / t, z: self.z / t}

    operator +=(o &Vec3):
        self.x += o.x
        self.y += o.y
        self.z += o.z

    fn neg() Vec3:
        return {x: -self.x, y: -self.y, z: -self.z}

    fn dot(o &Vec3) f64:
        return self.x * o.x + self.y * o.y + self.z * o.z

    fn length_squared() f64:
        return self.dot(self)

    fn length() f64:
        return sqrt(self.length_squared())

    fn cross(o &Vec3) Vec3:
        return {x: self.y * o.z - self.z * o.y, y: self.z * o.x - self.x * o.z, z: self.x * o.y - self.y * o.x}

    fn normalize() Vec3:
        len f64 = self.length()
        if len < 0.00000001:
            return {x: self.x, y: self.y, z: self.z}
        return {x: self.x / len, y: self.y / len, z: self.z / len}

fn reflect(v Vec3, n Vec3) Vec3:
    return v - n * (2.0 * v.dot(n))

fn refract(dir Vec3, n Vec3, eta f64) Vec3:
    cos_theta f64 = fmin(dir.neg().dot(n), 1.0)
    perpendicular Vec3 = (dir + n * cos_theta) * eta
    parallel Vec3 = n * -sqrt(fabs(1.0 - perpendicular.length_squared()))
    return perpendicular + parallel

fn rotate_x(v Vec3, angle f64) Vec3:
    c f64 = cos(angle)
    s f64 = sin(angle)
    return {x: v.x, y: v.y * c - v.z * s, z: v.y * s + v.z * c}

fn rotate_y(v Vec3, angle f64) Vec3:
    c f64 = cos(angle)
    s f64 = sin(angle)
    return {x: v.x * c + v.z * s, y: v.y, z: -v.x * s + v.z * c}

fn random_uniform() f64:
    return rand() as f64 / 2147483648.0

fn random_range(min f64, max f64) f64:
    return min + (max - min) * random_uniform()

fn random_unit_vector() Vec3:
    while True:
        p Vec3 = {x: random_range(-1.0, 1.0), y: random_range(-1.0, 1.0), z: random_range(-1.0, 1.0)}
        len2 f64 = p.length_squared()
        if len2 > 0.000001 and len2 <= 1.0:
            return p / sqrt(len2)
    return {x: 0.0, y: 1.0, z: 0.0}

struct Ray:
    origin Vec3
    direction Vec3

    fn at(t f64) Vec3:
        return self.origin + self.direction * t

fn ray(origin Vec3, direction Vec3) Ray:
    return {origin: origin, direction: direction}

struct Material:
    kind i32
    color Vec3
    ior f64

fn material(kind i32, color Vec3, ior f64) Material:
    return {kind: kind, color: color, ior: ior}

struct Hit:
    t f64
    point Vec3
    normal Vec3
    front_face bool
    material Material

fn hit_plane(r &Ray, point &Vec3, n &Vec3, t_min f64, t_max f64, t &f64) bool:
    denom f64 = n.dot(r.direction)
    if fabs(denom) < PARALLEL_EPSILON:
        return False
    t = (point - r.origin).dot(n) / denom
    return t > t_min and t < t_max

fn hit_disk(r &Ray, center &Vec3, n &Vec3, radius f64, t_min f64, t_max f64, t &f64) bool:
    if not hit_plane(&r, &center, &n, t_min, t_max, &t):
        return False
    return (r.at(t) - center).length_squared() <= radius * radius

struct Shape:
    kind i32
    material Material
    center Vec3
    radius f64
    normal Vec3
    a Vec3
    b Vec3
    c Vec3
    edge_u Vec3
    edge_v Vec3
    w Vec3
    axis Vec3
    height f64

    fn set_hit(h &Hit, r &Ray, t f64, outward Vec3):
        h.t = t
        h.point = r.at(t)
        h.front_face = r.direction.dot(outward) < 0.0
        if h.front_face:
            h.normal = outward
        else:
            h.normal = outward.neg()
        h.material = self.material

    fn move(offset Vec3):
        self.center += offset
        self.a += offset
        self.b += offset
        self.c += offset

    fn intersect(r &Ray, t_min f64, t_max f64, h &Hit) bool:
        if self.kind == SPHERE:
            return self.intersect_sphere(r, t_min, t_max, h)
        if self.kind == PLANE:
            t f64 = 0.0
            if not hit_plane(&r, &self.center, &self.normal, t_min, t_max, &t):
                return False
            self.set_hit(h, r, t, self.normal)
            return True
        if self.kind == TRIANGLE:
            return self.intersect_triangle(r, t_min, t_max, h)
        if self.kind == RECTANGLE:
            return self.intersect_rectangle(r, t_min, t_max, h)
        if self.kind == CYLINDER:
            return self.intersect_cylinder(r, t_min, t_max, h)
        return self.intersect_cone(r, t_min, t_max, h)

    fn intersect_sphere(r &Ray, t_min f64, t_max f64, h &Hit) bool:
        oc Vec3 = r.origin - self.center
        a f64 = r.direction.length_squared()
        half_b f64 = oc.dot(r.direction)
        c f64 = oc.length_squared() - self.radius * self.radius
        discriminant f64 = half_b * half_b - a * c
        if discriminant < 0.0:
            return False
        root f64 = sqrt(discriminant)
        t f64 = (-half_b - root) / a
        if t <= t_min or t >= t_max:
            t = (-half_b + root) / a
            if t <= t_min or t >= t_max:
                return False
        self.set_hit(h, r, t, (r.at(t) - self.center) / self.radius)
        return True

    fn intersect_triangle(r &Ray, t_min f64, t_max f64, h &Hit) bool:
        edge1 Vec3 = self.b - self.a
        edge2 Vec3 = self.c - self.a
        p Vec3 = r.direction.cross(edge2)
        det f64 = edge1.dot(p)
        if fabs(det) < PARALLEL_EPSILON:
            return False
        inv_det f64 = 1.0 / det
        s Vec3 = r.origin - self.a
        u f64 = s.dot(p) * inv_det
        if u < 0.0 or u > 1.0:
            return False
        q Vec3 = s.cross(edge1)
        v f64 = r.direction.dot(q) * inv_det
        if v < 0.0 or u + v > 1.0:
            return False
        t f64 = edge2.dot(q) * inv_det
        if t <= t_min or t >= t_max:
            return False
        self.set_hit(h, r, t, self.normal)
        return True

    fn intersect_rectangle(r &Ray, t_min f64, t_max f64, h &Hit) bool:
        t f64 = 0.0
        if not hit_plane(&r, &self.center, &self.normal, t_min, t_max, &t):
            return False
        p Vec3 = r.at(t) - self.center
        alpha f64 = p.cross(self.edge_v).dot(self.w)
        beta f64 = self.edge_u.cross(p).dot(self.w)
        if alpha < 0.0 or alpha > 1.0 or beta < 0.0 or beta > 1.0:
            return False
        self.set_hit(h, r, t, self.normal)
        return True

    fn intersect_cylinder(r &Ray, t_min f64, t_max f64, h &Hit) bool:
        half_height f64 = self.height * 0.5
        best_t f64 = t_max
        best_normal Vec3
        oc Vec3 = r.origin - self.center
        dir_axis f64 = r.direction.dot(self.axis)
        oc_axis f64 = oc.dot(self.axis)
        dir_perp Vec3 = r.direction - self.axis * dir_axis
        oc_perp Vec3 = oc - self.axis * oc_axis
        a f64 = dir_perp.length_squared()
        if a > PARALLEL_EPSILON:
            half_b f64 = oc_perp.dot(dir_perp)
            c f64 = oc_perp.length_squared() - self.radius * self.radius
            discriminant f64 = half_b * half_b - a * c
            if discriminant >= 0.0:
                root f64 = sqrt(discriminant)
                i i32 = 0
                while i < 2:
                    t f64 = (-half_b - root) / a
                    if i == 1:
                        t = (-half_b + root) / a
                    side_h f64 = oc_axis + t * dir_axis
                    if t > t_min and t < best_t and fabs(side_h) <= half_height:
                        best_t = t
                        best_normal = (oc_perp + dir_perp * t) / self.radius
                        break
                    i += 1
        side i32 = -1
        while side <= 1:
            cap_normal Vec3 = self.axis * (side as f64)
            cap_center Vec3 = self.center + cap_normal * half_height
            t f64 = 0.0
            if hit_disk(&r, &cap_center, &cap_normal, self.radius, t_min, best_t, &t):
                best_t = t
                best_normal = cap_normal
            side += 2
        if best_t >= t_max:
            return False
        self.set_hit(h, r, best_t, best_normal)
        return True

    fn intersect_cone(r &Ray, t_min f64, t_max f64, h &Hit) bool:
        best_t f64 = t_max
        best_normal Vec3
        ob Vec3 = r.origin - self.center
        dir_axis f64 = r.direction.dot(self.axis)
        ob_axis f64 = ob.dot(self.axis)
        dir_perp Vec3 = r.direction - self.axis * dir_axis
        ob_perp Vec3 = ob - self.axis * ob_axis
        k f64 = self.radius / self.height
        k2 f64 = k * k
        m f64 = self.height - ob_axis
        a f64 = dir_perp.length_squared() - k2 * dir_axis * dir_axis
        half_b f64 = ob_perp.dot(dir_perp) + k2 * m * dir_axis
        c f64 = ob_perp.length_squared() - k2 * m * m
        if fabs(a) > PARALLEL_EPSILON:
            discriminant f64 = half_b * half_b - a * c
            if discriminant >= 0.0:
                root f64 = sqrt(discriminant)
                t0 f64 = (-half_b - root) / a
                t1 f64 = (-half_b + root) / a
                if t0 > t1:
                    swap f64 = t0
                    t0 = t1
                    t1 = swap
                i i32 = 0
                while i < 2:
                    t f64 = t0
                    if i == 1:
                        t = t1
                    cone_h f64 = ob_axis + t * dir_axis
                    if t > t_min and t < best_t and cone_h >= 0.0 and cone_h <= self.height:
                        radial Vec3 = (ob_perp + dir_perp * t).normalize()
                        best_t = t
                        best_normal = (radial * self.height + self.axis * self.radius).normalize()
                        break
                    i += 1
        t f64 = 0.0
        down Vec3 = self.axis.neg()
        if hit_disk(&r, &self.center, &down, self.radius, t_min, best_t, &t):
            best_t = t
            best_normal = down
        if best_t >= t_max:
            return False
        self.set_hit(h, r, best_t, best_normal)
        return True

fn sphere(center Vec3, radius f64, m Material) Shape:
    s Shape
    s.kind = SPHERE
    s.center = center
    s.radius = radius
    s.material = m
    return s

fn plane(point Vec3, normal Vec3, m Material) Shape:
    s Shape
    s.kind = PLANE
    s.center = point
    s.normal = normal.normalize()
    s.material = m
    return s

fn triangle(a Vec3, b Vec3, c Vec3, m Material) Shape:
    s Shape
    s.kind = TRIANGLE
    s.a = a
    s.b = b
    s.c = c
    s.normal = (b - a).cross(c - a).normalize()
    s.material = m
    return s

fn cylinder(center Vec3, axis Vec3, radius f64, height f64, m Material) Shape:
    s Shape
    s.kind = CYLINDER
    s.center = center
    s.axis = axis.normalize()
    s.radius = radius
    s.height = height
    s.material = m
    return s

fn cone(base Vec3, axis Vec3, radius f64, height f64, m Material) Shape:
    s Shape
    s.kind = CONE
    s.center = base
    s.axis = axis.normalize()
    s.radius = radius
    s.height = height
    s.material = m
    return s

struct Scene:
    shapes Array<Shape>
    light_position Vec3
    light_color Vec3

    fn closest_hit(r &Ray, t_min f64, t_max f64, h &Hit) bool:
        found bool = False
        closest f64 = t_max
        i i32 = 0
        while i < self.shapes.size():
            if self.shapes[i].intersect(r, t_min, closest, h):
                found = True
                closest = h.t
            i += 1
        return found

    fn occluded(r &Ray, t_min f64, max_distance f64) bool:
        ignored Hit
        i i32 = 0
        while i < self.shapes.size():
            if self.shapes[i].intersect(r, t_min, max_distance, &ignored):
                return True
            i += 1
        return False

    fn add_default_objects():
        self.light_position = {x: -4.0, y: 6.0, z: 4.0}
        self.light_color = {x: 1.0, y: 0.9, z: 0.75}
        white Vec3 = {x: 1.0, y: 1.0, z: 1.0}
        self.shapes.append(sphere({x: 0.0, y: 0.75, z: 0.0}, 0.75, material(GLASS, white, 1.5)))
        self.shapes.append(sphere({x: -1.45, y: 0.6, z: -0.7}, 0.6, material(MIRROR, {x: 0.95, y: 0.95, z: 0.95}, 1.5)))
        self.shapes.append(cylinder({x: 1.35, y: 0.35, z: -0.4}, {x: 0.0, y: 1.0, z: 0.0}, 0.45, 0.7, material(DIFFUSE, {x: 40.0 / 255.0, y: 150.0 / 255.0, z: 160.0 / 255.0}, 1.5)))
        self.shapes.append(cone({x: 1.35, y: 0.7, z: -0.4}, {x: 0.0, y: 1.0, z: 0.0}, 0.4, 0.9, material(DIFFUSE, {x: 245.0 / 255.0, y: 150.0 / 255.0, z: 60.0 / 255.0}, 1.5)))
        palette Array<Vec3>
        palette.append({x: 240.0 / 255.0, y: 90.0 / 255.0, z: 90.0 / 255.0})
        palette.append({x: 250.0 / 255.0, y: 190.0 / 255.0, z: 60.0 / 255.0})
        palette.append({x: 110.0 / 255.0, y: 210.0 / 255.0, z: 140.0 / 255.0})
        palette.append({x: 80.0 / 255.0, y: 160.0 / 255.0, z: 240.0 / 255.0})
        palette.append({x: 170.0 / 255.0, y: 110.0 / 255.0, z: 230.0 / 255.0})
        i i32 = 0
        while i < 5:
            angle f64 = ((i - 2) as f64) * 0.38
            center Vec3 = {x: 1.4 * sin(angle), y: 0.2, z: 1.3 - 0.9 * (1.0 - cos(angle))}
            self.shapes.append(sphere(center, 0.2, material(DIFFUSE, palette[i], 1.5)))
            i += 1
        self.shapes.append(plane({x: 0.0, y: 0.0, z: 0.0}, {x: 0.0, y: 1.0, z: 0.0}, material(DIFFUSE, {x: 160.0 / 255.0, y: 145.0 / 255.0, z: 135.0 / 255.0}, 1.5)))
        self.shapes.append(plane({x: 0.0, y: 0.0, z: -4.0}, {x: 0.0, y: 0.0, z: 1.0}, material(DIFFUSE, {x: 30.0 / 255.0, y: 40.0 / 255.0, z: 75.0 / 255.0}, 1.5)))
        self.shapes.append(triangle({x: -2.4, y: 0.0, z: -2.6}, {x: -0.9, y: 0.0, z: -2.9}, {x: -1.6, y: 2.0, z: -2.75}, material(DIFFUSE, {x: 250.0 / 255.0, y: 210.0 / 255.0, z: 90.0 / 255.0}, 1.5)))

struct Camera:
    width i32
    height i32
    fov f64
    position Vec3
    yaw f64
    pitch f64
    right Vec3
    up Vec3
    back Vec3
    first_pixel Vec3
    pixel_right Vec3
    pixel_down Vec3

    fn reset():
        self.fov = 45.0
        self.position = {x: 0.0, y: 1.35, z: 4.7}
        self.yaw = 0.0
        self.pitch = 0.0
        self.update()

    fn update():
        forward Vec3 = rotate_y(rotate_x({x: 0.0, y: -0.2, z: -1.0}, self.pitch), self.yaw)
        world_up Vec3 = rotate_y(rotate_x({x: 0.0, y: 1.0, z: 0.0}, self.pitch), self.yaw)
        self.back = forward.neg().normalize()
        self.right = world_up.cross(self.back).normalize()
        self.up = self.back.cross(self.right)
        view_height f64 = 2.0 * tan(self.fov * 0.5 * PI / 180.0)
        view_width f64 = view_height * (self.width as f64) / (self.height as f64)
        view_right Vec3 = self.right * view_width
        view_down Vec3 = self.up * -view_height
        self.pixel_right = view_right / (self.width as f64)
        self.pixel_down = view_down / (self.height as f64)
        view_center Vec3 = self.position - self.back
        top_left Vec3 = view_center - (view_right + view_down) * 0.5
        self.first_pixel = top_left + (self.pixel_right + self.pixel_down) * 0.5

    fn rotate(d_yaw f64, d_pitch f64):
        self.yaw += d_yaw
        self.pitch += d_pitch
        self.update()

    fn move(local Vec3):
        self.position += self.right * local.x + self.up * local.y + self.back * local.z
        self.update()

    fn ray_for(x i32, y i32) Ray:
        px f64 = (x as f64) + random_range(-0.5, 0.5)
        py f64 = (y as f64) + random_range(-0.5, 0.5)
        target Vec3 = self.first_pixel + self.pixel_right * px + self.pixel_down * py
        return ray(self.position, (target - self.position).normalize())

fn sky(direction Vec3) Vec3:
    a f64 = 0.5 * (direction.y + 1.0)
    ground Vec3 = {x: 0.85, y: 0.65, z: 0.5}
    top Vec3 = {x: 0.25, y: 0.35, z: 0.65}
    return ground * (1.0 - a) + top * a

fn reflectance(cosine f64, eta f64) f64:
    r0 f64 = (1.0 - eta) / (1.0 + eta)
    r0 = r0 * r0
    return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0)

fn direct_light(scene &Scene, h &Hit) Vec3:
    to_light Vec3 = scene.light_position - h.point
    distance f64 = to_light.length()
    light_direction Vec3 = to_light / distance
    cosine f64 = h.normal.dot(light_direction)
    if cosine <= 0.0:
        return {x: 0.0, y: 0.0, z: 0.0}
    if scene.occluded(ray(h.point, light_direction), HIT_EPSILON, distance):
        return {x: 0.0, y: 0.0, z: 0.0}
    return scene.light_color * cosine

fn trace(scene &Scene, start Ray) Vec3:
    r Ray = start
    result Vec3 = {x: 0.0, y: 0.0, z: 0.0}
    throughput Vec3 = {x: 1.0, y: 1.0, z: 1.0}
    bounce i32 = 0
    while bounce < MAX_BOUNCES:
        h Hit
        if not scene.closest_hit(&r, HIT_EPSILON, FAR, &h):
            result += throughput * sky(r.direction)
            break
        m Material = h.material
        new_direction Vec3
        if m.kind == DIFFUSE:
            result += throughput * m.color * direct_light(&scene, &h)
            new_direction = h.normal + random_unit_vector()
            if new_direction.length_squared() < 0.00000001:
                new_direction = h.normal
        elif m.kind == MIRROR:
            new_direction = reflect(r.direction, h.normal)
        else:
            eta f64 = m.ior
            if h.front_face:
                eta = 1.0 / m.ior
            cos_theta f64 = fmin(r.direction.neg().dot(h.normal), 1.0)
            sin_theta f64 = sqrt(1.0 - cos_theta * cos_theta)
            total_reflection bool = eta * sin_theta > 1.0
            if total_reflection or reflectance(cos_theta, eta) > random_uniform():
                new_direction = reflect(r.direction, h.normal)
            else:
                new_direction = refract(r.direction, h.normal, eta)
        throughput = throughput * m.color
        r = ray(h.point, new_direction.normalize())
        bounce += 1
    return result

fn to_pixel(c Vec3) u32:
    red u32 = (255.99 * sqrt(fmin(c.x, 1.0))) as u32
    green u32 = (255.99 * sqrt(fmin(c.y, 1.0))) as u32
    blue u32 = (255.99 * sqrt(fmin(c.z, 1.0))) as u32
    return red * 16777216 + green * 65536 + blue * 256 + 255

fn main() i32:
    SDL_Init(SDL_INIT_VIDEO)
    window i8[] = SDL_CreateWindow("ura raytracer", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, WIDTH, HEIGHT, SDL_WINDOW_SHOWN)
    renderer i8[] = SDL_CreateRenderer(window, -1, SDL_RENDERER_ACCELERATED)
    texture i8[] = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGBA8888, SDL_TEXTUREACCESS_STREAMING, WIDTH, HEIGHT)

    scene Scene
    scene.add_default_objects()
    camera Camera
    camera.width = WIDTH
    camera.height = HEIGHT
    camera.reset()

    accumulated Array<Vec3>
    accumulated.resize(WIDTH * HEIGHT)
    pixels u32[] = calloc((WIDTH * HEIGHT) as i64, 4 as i64) as u32[]
    none i8[]
    title i8[] = malloc(64)
    samples i32 = 0
    quit bool = False
    event SDL_Event

    while not quit:
        changed bool = False
        while SDL_PollEvent(&event) != 0:
            if event.type == SDL_QUIT:
                quit = True
            if event.type == SDL_KEYDOWN:
                key i32 = event.sym
                if key == SDLK_ESCAPE:
                    quit = True
                if key == SDLK_r:
                    camera.reset()
                    changed = True
                if key == SDLK_UP:
                    camera.move({
                            x: 0.0, 
                            y: CAMERA_STEP, 
                            z: 0.0
                        })
                    changed = True
                if key == SDLK_DOWN:
                    camera.move({x: 0.0, y: -CAMERA_STEP, z: 0.0})
                    changed = True
                if key == SDLK_LEFT:
                    camera.move({x: -CAMERA_STEP, y: 0.0, z: 0.0})
                    changed = True
                if key == SDLK_RIGHT:
                    camera.move({x: CAMERA_STEP, y: 0.0, z: 0.0})
                    changed = True
                if key == SDLK_PAGEUP:
                    camera.move({x: 0.0, y: 0.0, z: -CAMERA_STEP})
                    changed = True
                if key == SDLK_PAGEDOWN:
                    camera.move({x: 0.0, y: 0.0, z: CAMERA_STEP})
                    changed = True
        if changed:
            samples = 0
            i i32 = 0
            while i < WIDTH * HEIGHT:
                accumulated[i] = {x: 0.0, y: 0.0, z: 0.0}
                i += 1

        start u32 = SDL_GetTicks()
        samples += 1
        inverse f64 = 1.0 / (samples as f64)
        y i32 = 0
        while y < HEIGHT:
            x i32 = 0
            while x < WIDTH:
                i i32 = y * WIDTH + x
                accumulated[i] += trace(&scene, camera.ray_for(x, y))
                pixels[i] = to_pixel(accumulated[i] * inverse)
                x += 1
            y += 1
        elapsed u32 = SDL_GetTicks() - start

        SDL_UpdateTexture(texture, none, pixels as i8[], WIDTH * 4)
        SDL_RenderCopy(renderer, texture, none, none)
        SDL_RenderPresent(renderer)
        sprintf(title, "%u ms | %d samples", elapsed, samples)
        SDL_SetWindowTitle(window, title)

    SDL_DestroyTexture(texture)
    SDL_DestroyRenderer(renderer)
    SDL_DestroyWindow(window)
    SDL_Quit()
    return 0
