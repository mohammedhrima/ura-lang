{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ura",
  "scopeName": "source.ura",
  "comment": "Keep these word lists in sync with ura-lang's src/main.c (keywords[], builtins[], specials[]) and server/src/core/keywords.ts.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#format-strings" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#directives" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#scopes" },
    { "include": "#calls" },
    { "include": "#names" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.ura", "match": "//.*$" },
        { "name": "comment.block.ura", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.ura", "match": "\\\\[ntrbfva0?\\\\\"']" },
        { "name": "invalid.illegal.unknown-escape.ura", "match": "\\\\." }
      ]
    },
    "format-strings": {
      "name": "string.interpolated.ura",
      "begin": "(\\$)(\")",
      "end": "\"|$",
      "beginCaptures": {
        "1": { "name": "storage.type.format.ura" },
        "2": { "name": "punctuation.definition.string.begin.ura" }
      },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.ura" } },
      "patterns": [
        { "include": "#escapes" },
        {
          "name": "meta.embedded.expression.ura",
          "contentName": "source.ura",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.ura" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.ura" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ura",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [{ "include": "#escapes" }]
    },
    "characters": {
      "name": "string.quoted.single.ura",
      "begin": "'",
      "end": "'|$",
      "patterns": [{ "include": "#escapes" }]
    },
    "directives": {
      "patterns": [
        { "name": "keyword.control.directive.ura", "match": "@(if|elif|else|error|name|version|main|script|dependency)\\b" },
        { "name": "support.function.directive.ura", "match": "\\binstalled(?=\\s*\\()" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(?:(pub)\\s+)?(fn|proto)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.modifier.ura" },
            "2": { "name": "keyword.declaration.function.ura" },
            "3": { "name": "entity.name.function.ura" }
          }
        },
        {
          "match": "\\b(operator)\\s*([^\\s(]+)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.declaration.function.ura" },
            "2": { "name": "entity.name.function.operator.ura" }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.struct.ura" },
            "2": { "name": "entity.name.type.struct.ura" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.enum.ura" },
            "2": { "name": "entity.name.type.enum.ura" }
          }
        },
        {
          "match": "\\b(mod)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.module.ura" },
            "2": { "name": "entity.name.namespace.ura" }
          }
        },
        {
          "match": "\\b(from)\\b",
          "captures": { "1": { "name": "storage.modifier.ura" } }
        },
        {
          "match": "\\b(template)\\s*(<)([^>]*)(>)",
          "captures": {
            "1": { "name": "storage.modifier.ura" },
            "2": { "name": "punctuation.definition.generic.begin.ura" },
            "3": { "name": "entity.name.type.parameter.ura" },
            "4": { "name": "punctuation.definition.generic.end.ura" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.import.ura", "match": "\\b(use|link)\\b" },
        {
          "name": "keyword.control.ura",
          "match": "\\b(if|elif|else|while|for|in|break|continue|return|match|case|default|try|catch|throw)\\b"
        },
        { "name": "keyword.operator.word.ura", "match": "\\b(and|or|not|is|as)\\b" },
        { "name": "storage.modifier.ura", "match": "\\b(pub|template|operator)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ura",
          "match": "\\b(bool|i1|char|unic|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|void|num)\\b"
        },
        { "name": "keyword.operator.reference.ura", "match": "(?<![\\w)\\]&])&(?=[A-Za-z_&(])" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.ura", "match": "\\b(True|False)\\b" },
        { "name": "constant.language.null.ura", "match": "\\bnull\\b" },
        { "name": "variable.language.self.ura", "match": "\\bself\\b" },
        { "name": "support.variable.ura", "match": "\\bura::(argc|argv)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.ura", "match": "\\b\\d+\\.\\d+f?\\b" },
        { "name": "constant.numeric.integer.ura", "match": "\\b\\d+\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ura",
          "match": "(?<![.:])\\b(output|errput|input|sizeof|typeof|drop|isZero|memory_alloc|memory_copy|memory_free)\\b(?=\\s*\\()"
        }
      ]
    },
    "scopes": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(::)",
          "captures": {
            "1": { "name": "entity.name.type.ura" },
            "2": { "name": "punctuation.accessor.double-colon.ura" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=(?:<[^()]*>)?\\s*\\()",
          "captures": { "1": { "name": "entity.name.function.call.ura" } }
        }
      ]
    },
    "names": {
      "patterns": [
        { "name": "constant.other.ura", "match": "\\b[A-Z][A-Z0-9_]+\\b" },
        { "name": "entity.name.type.ura", "match": "\\b[A-Z]\\w*\\b" },
        {
          "match": "(\\.)\\s*([A-Za-z_]\\w*+)(?!\\s*(?:<[^()]*>)?\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.ura" },
            "2": { "name": "variable.other.member.ura" }
          }
        },
        { "name": "variable.other.ura", "match": "\\b[A-Za-z_]\\w*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.variadic.ura", "match": "\\.\\.\\." },
        { "name": "keyword.operator.assignment.compound.ura", "match": "\\+=|-=|\\*=|/=|%=|<<=|>>=|&=|\\|=|\\^=" },
        { "name": "keyword.operator.comparison.ura", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.ura", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.ura", "match": "<<|>>|&|\\||\\^|~" },
        { "name": "keyword.operator.comparison.ura", "match": "<|>" },
        { "name": "keyword.operator.arithmetic.ura", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.assignment.ura", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.block.begin.ura", "match": ":" },
        { "name": "punctuation.separator.comma.ura", "match": "," },
        { "name": "punctuation.section.brackets.ura", "match": "[\\[\\]]" },
        { "name": "punctuation.section.braces.ura", "match": "[{}]" },
        { "name": "punctuation.section.parens.ura", "match": "[()]" }
      ]
    }
  }
}
