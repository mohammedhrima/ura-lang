{
  "function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) ${3:i32}:", "\t${0:return 0}"],
    "description": "A function"
  },
  "main": {
    "prefix": "main",
    "body": ["fn main() i32:", "\t${0}", "\treturn 0"],
    "description": "The program's entry point"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}:",
      "\t${2:field} ${3:i32}",
      "",
      "\tpub fn create(${2:field} ${3:i32}) ${1:Name}:",
      "\t\tres ${1:Name}",
      "\t\tres.${2:field} = ${2:field}",
      "\t\treturn res${0}"
    ],
    "description": "A struct with one attribute and its constructor, Name::create(...)"
  },
  "struct from": {
    "prefix": "from",
    "body": ["struct ${1:Name} from ${2:Base}:", "\t${0}"],
    "description": "A struct that takes the attributes and methods of another one"
  },
  "method": {
    "prefix": "method",
    "body": ["fn ${1:name}(${2}) ${3:i32}:", "\t${0:return self.${4:field}}"],
    "description": "A method (inside a struct; self is the struct it's called on)"
  },
  "operator": {
    "prefix": "operator",
    "body": ["operator ${1:+}(other &${2:Name}) ${2:Name}:", "\t${0}"],
    "description": "An operator of a struct"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name}: ${2:FIRST}, ${0:SECOND}"],
    "description": "An enum; read a variant as Name::FIRST"
  },
  "mod": {
    "prefix": "mod",
    "body": ["mod ${1:name}:", "\t${0}"],
    "description": "A module; its names are read as name::x"
  },
  "template": {
    "prefix": "template",
    "body": ["template<${1:T}>:", "\t${0}"],
    "description": "A template struct or fn"
  },
  "if": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "\t${0}"],
    "description": "if"
  },
  "if / elif / else": {
    "prefix": "ife",
    "body": ["if ${1:condition}:", "\t${2}", "elif ${3:condition}:", "\t${4}", "else:", "\t${0}"],
    "description": "if / elif / else"
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:condition}:", "\t${0}"],
    "description": "while loop"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:i} in Range::create(${2:0}, ${3:n}):", "\t${0}"],
    "description": "for loop over a range"
  },
  "for in": {
    "prefix": "forin",
    "body": ["for ${1:item} in ${2:items}:", "\t${0}"],
    "description": "for loop over anything with operator in"
  },
  "match": {
    "prefix": "match",
    "body": ["match ${1:value}:", "\tcase ${2:1}:", "\t\t${3}", "\tdefault:", "\t\t${0}"],
    "description": "match / case / default"
  },
  "try / catch": {
    "prefix": "try",
    "body": ["try:", "\t${1}", "catch ${2:e} ${3:Error}:", "\t${0}"],
    "description": "try / catch"
  },
  "use": {
    "prefix": "use",
    "body": ["use \"${1:./file}\""],
    "description": "Use another .ura file (path relative to this one, without .ura) or a package (@/name)"
  },
  "proto": {
    "prefix": "proto",
    "body": ["proto ${1:name}(${2}) ${0:i32}"],
    "description": "Declare a C function"
  }
}
