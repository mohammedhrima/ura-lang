use "@/posix"

fn env(key String) String:
    value char[] = getenv(key.chars())
    if value == null:
        return ""
    return String::create(value)

fn user() String:
    @if os == "windows":
        return env("USERNAME")
    @elif os == "linux":
        return env("USER")
    @elif os == "macos":
        return env("USER")
    @else:
        return "unknown user"
