struct Node:
    value i32
    next &Node

fn main() i32:
    c Node
    c.value = 3
    c.next 
    b Node
    b.value = 2
    b.next = &c
    a Node
    a.value = 1
    a.next = &b
    sum i32 = 0
    p &Node = &a
    while isNullable(p):
        sum += p.value
        p = &p.next
    return sum + a.next.next.value * 10