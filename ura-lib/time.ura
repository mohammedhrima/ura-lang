// time.h — time and date.
//
// On both Linux glibc (64-bit) and macOS arm64 the POSIX time types are 8 bytes
// (time_t, suseconds_t is 4). `struct timespec` and `struct timeval` have the
// same layout on both platforms in 64-bit mode.

struct Timespec:
    tv_sec   i64      // time_t
    tv_nsec  i64      // i64

struct Timeval:
    tv_sec   i64      // time_t
    tv_usec  i32       // suseconds_t (i32)
    __pad    i32       // explicit pad so total is 16 bytes / 8-byte aligned

// `struct tm` — broken-down calendar time. Same field set on Linux glibc and
// macOS (both expose POSIX + BSD extensions: tm_gmtoff and tm_zone).
struct Tm:
    tm_sec    i32
    tm_min    i32
    tm_hour   i32
    tm_mday   i32
    tm_mon    i32
    tm_year   i32
    tm_wday   i32
    tm_yday   i32
    tm_isdst  i32
    tm_gmtoff i64          // i64
    tm_zone   i8[]       // const char *

// Time manipulation
proto time(timer i8[]) i64
proto difftime(time1 i64, time0 i64) f64
proto clock() i64

// Conversion (returned struct tm* points to thread-local static storage).
// `timer` is a i8[] to a time_t (so we type it as `ref ... i64` — the
// most ergonomic form for `t i64 = time(0); localtime(t)` callers).
proto gmtime(timer &i64) i8[]
proto localtime(timer &i64) i8[]
proto mktime(timeptr i8[]) i64
proto gmtime_r(timer &i64, result i8[]) i8[]
proto localtime_r(timer &i64, result i8[]) i8[]

// Formatting
proto strftime(s i8[], maxsize i64, format i8[], timeptr i8[]) i64
proto asctime(timeptr i8[]) i8[]
proto ctime(timer i8[]) i8[]
proto asctime_r(timeptr i8[], buf i8[]) i8[]
proto ctime_r(timer i8[], buf i8[]) i8[]

// High-resolution time (CLOCK_REALTIME = 0 on both Linux and macOS).
// Timespec/Timeval args are typed `i8[]` so callers can pass `ref ts` or
// a raw buffer.
proto clock_gettime(clk_id i32, tp i8[]) i32
proto clock_settime(clk_id i32, tp i8[]) i32
proto nanosleep(req i8[], rem i8[]) i32

// Wall-clock / time-of-day (POSIX, on both)
proto gettimeofday(tv i8[], tz i8[]) i32
