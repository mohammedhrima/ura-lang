@if installed("raylib"):
    link "raylib"
@elif os == "macos":
    @error "raylib is not installed" "brew install raylib"
@elif os == "windows":
    @error "raylib is not installed" "download raylib from https://raylib.com"
@else:
    @error "raylib is not installed" "sudo apt install libraylib-dev"

struct Color:
    r char
    g char
    b char
    a char

fn setColor(r i32, g i32, b i32, a i32) Color:
    c Color
    c.r = r as char
    c.g = g as char
    c.b = b as char
    c.a = a as char
    return c

proto InitWindow(width i32, height i32, title i8[]) void
proto CloseWindow() void
proto WindowShouldClose() bool
proto SetTargetFPS(fps i32) void
proto GetFrameTime() f32
proto BeginDrawing() void
proto EndDrawing() void
proto ClearBackground(color Color) void
proto DrawRectangle(x i32, y i32, w i32, h i32, color Color) void
proto DrawRectangleLines(x i32, y i32, w i32, h i32, color Color) void
proto DrawLine(x1 i32, y1 i32, x2 i32, y2 i32, color Color) void
proto DrawText(text i8[], x i32, y i32, size i32, color Color) void
proto MeasureText(text i8[], size i32) i32
proto IsKeyPressed(key i32) bool
proto ColorBrightness(color Color, factor f32) Color
proto TextFormat(fmt i8[], ...) i8[]
proto SetRandomSeed(seed i32) void
proto GetRandomValue(min i32, max i32) i32

KEY_LEFT  i32 = 263
KEY_RIGHT i32 = 262
KEY_UP    i32 = 265
KEY_DOWN  i32 = 264
KEY_SPACE i32 = 32
KEY_P     i32 = 80
KEY_R     i32 = 82
