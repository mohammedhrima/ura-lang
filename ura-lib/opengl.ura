// OpenGL 1.x fixed pipeline plus textures: enough to draw shapes and blit
// pixel buffers. Needs a context first, e.g. SDL_GL_CreateContext from "@/sdl2".
@if os == "windows":
    link "opengl32"
@elif os == "macos":
    link "OpenGL"
@elif installed("GL"):
    link "GL"
@else:
    @error "OpenGL is not installed" "sudo apt install libgl-dev"

// ── clearing and viewport ──
GL_DEPTH_BUFFER_BIT u32 = 256
GL_COLOR_BUFFER_BIT u32 = 16384

proto glClearColor(r f32, g f32, b f32, a f32)
proto glClear(mask u32)
proto glViewport(x i32, y i32, w i32, h i32)
proto glFlush()
proto glFinish()
proto glGetError() u32

GL_VENDOR u32 = 7936
GL_RENDERER u32 = 7937
GL_VERSION u32 = 7938

proto glGetString(name u32) i8[]

// ── state ──
GL_BLEND u32 = 3042
GL_DEPTH_TEST u32 = 2929
GL_TEXTURE_2D u32 = 3553
GL_SRC_ALPHA u32 = 770
GL_ONE_MINUS_SRC_ALPHA u32 = 771

proto glEnable(cap u32)
proto glDisable(cap u32)
proto glBlendFunc(src u32, dst u32)

// ── matrices ──
GL_MODELVIEW u32 = 5888
GL_PROJECTION u32 = 5889

proto glMatrixMode(mode u32)
proto glLoadIdentity()
proto glOrtho(left f64, right f64, bottom f64, top f64, near f64, far f64)
proto glTranslatef(x f32, y f32, z f32)
proto glRotatef(angle f32, x f32, y f32, z f32)
proto glScalef(x f32, y f32, z f32)
proto glPushMatrix()
proto glPopMatrix()

// ── drawing ──
GL_POINTS u32 = 0
GL_LINES u32 = 1
GL_LINE_LOOP u32 = 2
GL_LINE_STRIP u32 = 3
GL_TRIANGLES u32 = 4
GL_TRIANGLE_STRIP u32 = 5
GL_TRIANGLE_FAN u32 = 6
GL_QUADS u32 = 7

proto glBegin(mode u32)
proto glEnd()
proto glVertex2f(x f32, y f32)
proto glVertex3f(x f32, y f32, z f32)
proto glColor3f(r f32, g f32, b f32)
proto glColor4f(r f32, g f32, b f32, a f32)
proto glTexCoord2f(s f32, t f32)
proto glPointSize(size f32)
proto glLineWidth(width f32)

// ── textures ──
GL_TEXTURE_MAG_FILTER u32 = 10240
GL_TEXTURE_MIN_FILTER u32 = 10241
GL_NEAREST i32 = 9728
GL_LINEAR i32 = 9729
GL_RGB u32 = 6407
GL_RGBA u32 = 6408
GL_UNSIGNED_BYTE u32 = 5121
GL_FLOAT u32 = 5126

proto glGenTextures(n i32, textures &u32)
proto glDeleteTextures(n i32, textures &u32)
proto glBindTexture(target u32, texture u32)
proto glTexParameteri(target u32, pname u32, param i32)
proto glTexImage2D(target u32, level i32, internal i32, w i32, h i32, border i32, format u32, type u32, pixels i8[])
proto glTexSubImage2D(target u32, level i32, x i32, y i32, w i32, h i32, format u32, type u32, pixels i8[])
