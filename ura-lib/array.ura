proto calloc(len i64, size i64) i8[]
proto memcpy(dest i8[], src i8[], n i32) i8[]
proto free(ptr i8[])

template<T>:
    struct Array:
        data T[]
        count i32
        cap i32

        fn reserve(cap i32):
            if cap <= self.cap:
                return
            bigger T[] = calloc(cap as i64, sizeof(T) as i64) as T[]
            memcpy(bigger as i8[], self.data as i8[], self.count * sizeof(T))
            free(self.data as i8[])
            self.data = bigger
            self.cap = cap

        fn resize(size i32):
            self.reserve(size)
            while self.count > size:
                self.count -= 1
                drop(self.data[self.count])
            self.count = size

        fn push_back(value T):
            if self.count == self.cap:
                self.reserve(self.cap * 2 + 4)
            self.data[self.count] = value
            self.count += 1

        fn append(value T):
            self.push_back(value)

        fn insert(index i32, value T):
            if self.count == self.cap:
                self.reserve(self.cap * 2 + 4)
            i i32 = self.count
            while i > index:
                self.data[i] = self.data[i - 1]
                i -= 1
            self.data[index] = value
            self.count += 1

        fn push_front(value T):
            self.insert(0, value)

        fn remove(index i32) T:
            value T = self.data[index]
            i i32 = index
            while i < self.count - 1:
                self.data[i] = self.data[i + 1]
                i += 1
            self.count -= 1
            drop(self.data[self.count])
            return value

        fn pop_back() T:
            self.count -= 1
            value T = self.data[self.count]
            drop(self.data[self.count])
            return value

        fn pop() T:
            return self.pop_back()

        fn pop_front() T:
            return self.remove(0)

        fn front() &T:
            return &self.data[0]

        fn back() &T:
            return &self.data[self.count - 1]

        fn size() i32:
            return self.count

        fn capacity() i32:
            return self.cap

        fn empty() bool:
            return self.count == 0

        fn clear():
            while self.count > 0:
                self.count -= 1
                drop(self.data[self.count])

        fn reverse():
            i i32 = 0
            j i32 = self.count - 1
            while i < j:
                tmp T = self.data[i]
                self.data[i] = self.data[j]
                self.data[j] = tmp
                i += 1
                j -= 1

        fn release():
            self.clear()
            free(self.data as i8[])
            drop(self.data)
            self.cap = 0

        operator [](index i32) &T:
            return &self.data[index]

        operator =(other &Array):
            self.clear()
            self.reserve(other.count)
            i i32 = 0
            while i < other.count:
                self.data[i] = other.data[i]
                i += 1
            self.count = other.count

        operator drop():
            self.clear()
            free(self.data as i8[])
