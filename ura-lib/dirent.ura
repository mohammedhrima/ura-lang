// dirent.h — directory iteration.
// `struct dirent` differs between Linux glibc and macOS.

// BLOCKED: `@if` conditional compilation is not implemented (TODO.md M9).
// `@` lexes as an ordinary identifier character, so `@if linux:` parses as a
// bare identifier and then fails. Uncomment once @if lands.
//
// @if linux:
//     struct Dirent:
//         d_ino      i64           // ino_t
//         d_off      i64           // off_t
//         d_reclen   i16          // unsigned i16
//         d_type     char           // unsigned char (file-type hint)
//         d_name0    char           // start of inline name buffer (NAME_MAX+1 = 256 i8[])
//         // The rest of d_name follows in memory; access via i8[] arithmetic
//         // or through readdir's returned i8[].
//
// @elif macos:
//     struct Dirent:
//         d_ino      i64           // __darwin_ino64_t
//         d_seekoff  i64           // __darwin_off_t
//         d_reclen   i16          // __uint16_t
//         d_namlen   i16          // __uint16_t (length of d_name)
//         d_type     char           // __uint8_t
//         d_name0    char           // start of inline name buffer (1024 i8[] on Darwin)

// DIR* is opaque on both — use `i8[]`.
proto opendir(path i8[]) i8[]
proto fdopendir(fd i32) i8[]
proto closedir(dirp i8[]) i32
proto readdir(dirp i8[]) i8[]   // returns struct dirent*
proto rewinddir(dirp i8[]) void
proto telldir(dirp i8[]) i64
proto seekdir(dirp i8[], loc i64) void
