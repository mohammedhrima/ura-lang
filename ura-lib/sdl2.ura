// SDL2: windows, 2D rendering, textures, events, keyboard, timers, GL contexts.
// Pointers to SDL objects (SDL_Window *, SDL_Renderer *, SDL_Texture *) are i8[].
@if installed("SDL2"):
    link "SDL2"
@elif os == "macos":
    @error "SDL2 is not installed" "brew install sdl2"
@elif os == "windows":
    @error "SDL2 is not installed" "download SDL2 from https://libsdl.org"
@else:
    @error "SDL2 is not installed" "sudo apt install libsdl2-dev"

// ── init ──
SDL_INIT_TIMER u32 = 1
SDL_INIT_AUDIO u32 = 16
SDL_INIT_VIDEO u32 = 32
SDL_INIT_EVENTS u32 = 16384

proto SDL_Init(flags u32) i32
proto SDL_Quit()
proto SDL_GetError() i8[]

// ── windows ──
SDL_WINDOWPOS_UNDEFINED i32 = 536805376
SDL_WINDOWPOS_CENTERED i32 = 805240832
SDL_WINDOW_FULLSCREEN u32 = 1
SDL_WINDOW_OPENGL u32 = 2
SDL_WINDOW_SHOWN u32 = 4
SDL_WINDOW_RESIZABLE u32 = 32

proto SDL_CreateWindow(title i8[], x i32, y i32, w i32, h i32, flags u32) i8[]
proto SDL_DestroyWindow(window i8[])
proto SDL_SetWindowTitle(window i8[], title i8[])
proto SDL_GetWindowSize(window i8[], w &i32, h &i32)
proto SDL_ShowCursor(toggle i32) i32

// ── rendering ──
SDL_RENDERER_SOFTWARE u32 = 1
SDL_RENDERER_ACCELERATED u32 = 2
SDL_RENDERER_PRESENTVSYNC u32 = 4

struct SDL_Rect:
    x i32
    y i32
    w i32
    h i32

proto SDL_CreateRenderer(window i8[], index i32, flags u32) i8[]
proto SDL_DestroyRenderer(renderer i8[])
proto SDL_SetRenderDrawColor(renderer i8[], r u8, g u8, b u8, a u8) i32
proto SDL_RenderClear(renderer i8[]) i32
proto SDL_RenderPresent(renderer i8[])
proto SDL_RenderDrawPoint(renderer i8[], x i32, y i32) i32
proto SDL_RenderDrawLine(renderer i8[], x1 i32, y1 i32, x2 i32, y2 i32) i32
proto SDL_RenderDrawRect(renderer i8[], rect &SDL_Rect) i32
proto SDL_RenderFillRect(renderer i8[], rect &SDL_Rect) i32

// ── textures: stream pixels from ura into the window ──
SDL_PIXELFORMAT_ARGB8888 u32 = 372645892
SDL_PIXELFORMAT_RGBA8888 u32 = 373694468
SDL_TEXTUREACCESS_STATIC i32 = 0
SDL_TEXTUREACCESS_STREAMING i32 = 1

proto SDL_CreateTexture(renderer i8[], format u32, access i32, w i32, h i32) i8[]
proto SDL_UpdateTexture(texture i8[], rect i8[], pixels i8[], pitch i32) i32
proto SDL_RenderCopy(renderer i8[], texture i8[], src i8[], dst i8[]) i32
proto SDL_DestroyTexture(texture i8[])

// ── events ──
// SDL_Event is a 56 byte union; this layout reads the common header and the
// keyboard event (scancode, sym). Other events reuse the same bytes.
SDL_QUIT u32 = 256
SDL_WINDOWEVENT u32 = 512
SDL_KEYDOWN u32 = 768
SDL_KEYUP u32 = 769
SDL_MOUSEMOTION u32 = 1024
SDL_MOUSEBUTTONDOWN u32 = 1025
SDL_MOUSEBUTTONUP u32 = 1026

struct SDL_Event:
    type u32
    timestamp u32
    window u32
    state u8
    repeat u8
    pad1 u8
    pad2 u8
    scancode i32
    sym i32
    rest1 i32
    rest2 i32
    rest3 i32
    rest4 i32
    rest5 i32
    rest6 i32
    rest7 i32
    rest8 i32

proto SDL_PollEvent(event &SDL_Event) i32
proto SDL_WaitEvent(event &SDL_Event) i32

// ── keyboard: SDL_GetKeyboardState(none)[SDL_SCANCODE_X] != 0 while held ──
SDL_SCANCODE_A i32 = 4
SDL_SCANCODE_D i32 = 7
SDL_SCANCODE_S i32 = 22
SDL_SCANCODE_W i32 = 26
SDL_SCANCODE_ESCAPE i32 = 41
SDL_SCANCODE_SPACE i32 = 44
SDL_SCANCODE_RIGHT i32 = 79
SDL_SCANCODE_LEFT i32 = 80
SDL_SCANCODE_DOWN i32 = 81
SDL_SCANCODE_UP i32 = 82

proto SDL_GetKeyboardState(numkeys i8[]) u8[]

// ── timers ──
proto SDL_Delay(ms u32)
proto SDL_GetTicks() u32
proto SDL_GetTicks64() u64

// ── OpenGL contexts, use with "@/opengl" ──
SDL_GL_DOUBLEBUFFER i32 = 5
SDL_GL_DEPTH_SIZE i32 = 6
SDL_GL_CONTEXT_MAJOR_VERSION i32 = 17
SDL_GL_CONTEXT_MINOR_VERSION i32 = 18
SDL_GL_CONTEXT_PROFILE_MASK i32 = 21
SDL_GL_CONTEXT_PROFILE_CORE i32 = 1
SDL_GL_CONTEXT_PROFILE_COMPATIBILITY i32 = 2

proto SDL_GL_SetAttribute(attr i32, value i32) i32
proto SDL_GL_CreateContext(window i8[]) i8[]
proto SDL_GL_DeleteContext(context i8[])
proto SDL_GL_SwapWindow(window i8[])
proto SDL_GL_SetSwapInterval(interval i32) i32
proto SDL_GL_GetProcAddress(name i8[]) i8[]
