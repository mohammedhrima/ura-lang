// ctype.h — character classification + conversion. POSIX, identical signatures.
// Takes i32 (the char promoted) and returns i32 (0 / non-zero).

proto isalnum(c i32) i32
proto isalpha(c i32) i32
proto isascii(c i32) i32
proto isblank(c i32) i32
proto iscntrl(c i32) i32
proto isdigit(c i32) i32
proto isgraph(c i32) i32
proto islower(c i32) i32
proto isprint(c i32) i32
proto ispunct(c i32) i32
proto isspace(c i32) i32
proto isupper(c i32) i32
proto isxdigit(c i32) i32

// Case conversion
proto tolower(c i32) i32
proto toupper(c i32) i32
