// unistd.h — POSIX OS calls. Linux + macOS both POSIX-compatible here.

// Process IDs
proto getpid() i32
proto getppid() i32
proto getuid() i32
proto geteuid() i32
proto getgid() i32
proto getegid() i32
proto setuid(uid i32) i32
proto setgid(gid i32) i32

// Process control
proto fork() i32
proto execv(path i8[], argv i8[]) i32
proto execve(path i8[], argv i8[], envp i8[]) i32
proto execvp(file i8[], argv i8[]) i32
proto _exit(code i32) void

// Working directory
proto getcwd(buf i8[], size i64) i8[]
proto chdir(path i8[]) i32
proto fchdir(fd i32) i32

// File system: paths
proto access(path i8[], mode i32) i32
proto unlink(path i8[]) i32
proto rmdir(path i8[]) i32
// proto link(oldpath i8[], newpath i8[]) i32   (link is a keyword in ura)
proto symlink(target i8[], linkpath i8[]) i32
proto readlink(path i8[], buf i8[], bufsize i64) i64
proto rename(oldpath i8[], newpath i8[]) i32
proto truncate(path i8[], length i64) i32
proto ftruncate(fd i32, length i64) i32

// File descriptors
proto close(fd i32) i32
proto dup(fd i32) i32
proto dup2(oldfd i32, newfd i32) i32
proto pipe(pipefd i8[]) i32
proto lseek(fd i32, offset i64, whence i32) i64
proto isatty(fd i32) i32
proto ttyname(fd i32) i8[]

// Sleep
proto sleep(seconds i32) i32
proto usleep(microseconds i32) i32

// Host info
proto gethostname(name i8[], len i64) i32
proto sethostname(name i8[], len i64) i32

// Misc
proto alarm(seconds i32) i32
proto pause() i32
proto sync() void
proto fsync(fd i32) i32
proto fdatasync(fd i32) i32

// ── access() mode constants (POSIX, identical on Linux and macOS) ──────────
F_OK i32 = 0
X_OK i32 = 1
W_OK i32 = 2
R_OK i32 = 4

// ── lseek() whence constants ───────────────────────────────────────────────
SEEK_SET i32 = 0
SEEK_CUR i32 = 1
SEEK_END i32 = 2

// ── stdin/stdout/stderr file descriptors ───────────────────────────────────
STDIN_FILENO  i32 = 0
STDOUT_FILENO i32 = 1
STDERR_FILENO i32 = 2
