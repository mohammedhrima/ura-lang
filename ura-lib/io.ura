// File operations
proto fopen(path i8[], mode i8[]) i8[]
proto freopen(path i8[], mode i8[], file i8[]) i8[]
proto fclose(file i8[]) i32
proto fflush(file i8[]) i32

// Character I/O
proto fgetc(file i8[]) i32
proto fputc(c i32, file i8[]) i32
proto getc(file i8[]) i32
proto putc(c i32, file i8[]) i32
proto getchar() i32
proto putchar(c char) i32
proto ungetc(c i32, file i8[]) i32

// String I/O
proto fgets(buffer i8[], size i32, file i8[]) i8[]
proto fputs(str i8[], file i8[]) i32
proto puts(str i8[]) i32
proto gets(buffer i8[]) i8[]

// Block I/O
proto fread(ptr i8[], size i32, nmemb i32, file i8[]) i32
proto fwrite(ptr i8[], size i32, nmemb i32, file i8[]) i32
// ssize_t write(i32, const void *, u64) - i64, not i32, on 64-bit.
// This must match what codegen emits for runtime traps, or a program that
// imports io and also trips a guard fails LLVM module verification.
proto write(fd i32, ptr i8[], len i64) i64
proto read(fd i32, ptr i8[], len i64) i64

// File positioning
proto fseek(file i8[], offset i64, whence i32) i32
proto ftell(file i8[]) i64
proto rewind(file i8[]) void
proto fgetpos(file i8[], pos i8[]) i32
proto fsetpos(file i8[], pos i8[]) i32

// Error handling
proto feof(file i8[]) i32
proto ferror(file i8[]) i32
proto clearerr(file i8[]) void
proto perror(str i8[]) void

// Buffering
proto setvbuf(file i8[], buffer i8[], mode i32, size i32) i32
proto setbuf(file i8[], buffer i8[]) void

// File system operations
proto remove(path i8[]) i32
proto rename(oldpath i8[], newpath i8[]) i32

// Temporary files
proto tmpfile() i8[]
proto tmpnam(str i8[]) i8[]

// File descriptor operations (POSIX)
proto fileno(file i8[]) i32
proto fdopen(fd i32, mode i8[]) i8[]

// Formatted output
proto printf(format i8[], ...) i32
proto fprintf(file i8[], format i8[], ...) i32
proto sprintf(buffer i8[], format i8[], ...) i32
proto snprintf(buffer i8[], size i32, format i8[], ...) i32
proto dprintf(fd i32, format i8[], ...) i32

// Variadic formatted output
proto vprintf(format i8[], args i8[]) i32
proto vfprintf(file i8[], format i8[], args i8[]) i32
proto vsprintf(buffer i8[], format i8[], args i8[]) i32
proto vsnprintf(buffer i8[], size i32, format i8[], args i8[]) i32
proto vdprintf(fd i32, format i8[], args i8[]) i32

// Formatted input
proto scanf(format i8[], ...) i32
proto fscanf(file i8[], format i8[], ...) i32
proto sscanf(buffer i8[], format i8[], ...) i32

// Variadic formatted input
proto vscanf(format i8[], args i8[]) i32
proto vfscanf(file i8[], format i8[], args i8[]) i32
proto vsscanf(buffer i8[], format i8[], args i8[]) i32