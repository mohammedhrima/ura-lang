// Program termination
proto abort() void
proto exit(code i32) void
proto quick_exit(code i32) void
proto _Exit(code i32) void
// protoFunc i32 atexit(i8[] func)
// protoFunc i32 at_quick_exit(i8[] func)

// Environment
proto getenv(name i8[]) i8[]
proto setenv(name i8[], value i8[], overwrite i32) i32
proto unsetenv(name i8[]) i32
proto putenv(string i8[]) i32
proto system(command i8[]) i32

// Random numbers
proto rand() i32
proto srand(seed i32) void

// Searching and sorting
proto bsearch(key i8[], base i8[], nmemb i32, size i32, compar i8[]) i8[]
proto qsort(base i8[], nmemb i32, size i32, compar i8[]) void

// Integer arithmetic
proto abs(n i32) i32
proto labs(n i64) i64

// Division with quotient and remainder
proto div(numer i32, denom i32) i8[]
proto ldiv(numer i64, denom i64) i8[]

// String to number conversion
proto atoi(str i8[]) i32
proto atol(str i8[]) i64
proto atof(str i8[]) f64
proto strtol(str i8[], endptr i8[], base i32) i64
proto strtoul(str i8[], endptr i8[], base i32) i64
proto strtof(str i8[], endptr i8[]) f32
proto strtod(str i8[], endptr i8[]) f64
proto strtoll(str i8[], endptr i8[], base i32) i64
proto strtoull(str i8[], endptr i8[], base i32) i64

// Multibyte/wide character conversion
proto mblen(s i8[], n i32) i32
proto mbtowc(pwc i8[], s i8[], n i32) i32
proto wctomb(s i8[], wchar i32) i32
proto mbstowcs(dest i8[], src i8[], n i32) i32
proto wcstombs(dest i8[], src i8[], n i32) i32