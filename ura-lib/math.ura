// math.h — floating-point math. Identical signatures on Linux and macOS.
// Every function here takes and returns a C f64, so they must be declared
// f64. Declared f32, the linker would still bind them to libm's f64 entry
// points and silently produce wrong results.

// Trigonometric (radians)
proto sin(x f64) f64
proto cos(x f64) f64
proto tan(x f64) f64
proto asin(x f64) f64
proto acos(x f64) f64
proto atan(x f64) f64
proto atan2(y f64, x f64) f64

// Hyperbolic
proto sinh(x f64) f64
proto cosh(x f64) f64
proto tanh(x f64) f64
proto asinh(x f64) f64
proto acosh(x f64) f64
proto atanh(x f64) f64

// Exponential and logarithmic
proto exp(x f64) f64
proto exp2(x f64) f64
proto expm1(x f64) f64
proto log(x f64) f64
proto log2(x f64) f64
proto log10(x f64) f64
proto log1p(x f64) f64

// Power / roots
proto pow(x f64, y f64) f64
proto sqrt(x f64) f64
proto cbrt(x f64) f64
proto hypot(x f64, y f64) f64

// Rounding and remainder
proto ceil(x f64) f64
proto floor(x f64) f64
proto trunc(x f64) f64
proto round(x f64) f64
proto fmod(x f64, y f64) f64
proto remainder(x f64, y f64) f64

// Absolute, sign, min/max
proto fabs(x f64) f64
proto copysign(x f64, y f64) f64
proto fmax(x f64, y f64) f64
proto fmin(x f64, y f64) f64
proto fdim(x f64, y f64) f64

// Classification (returns i32)
proto isnan(x f64) i32
proto isinf(x f64) i32
proto isfinite(x f64) i32
proto signbit(x f64) i32

// Gamma and error functions
proto tgamma(x f64) f64
proto lgamma(x f64) f64
proto erf(x f64) f64
proto erfc(x f64) f64