# compiler output, at any depth
build/
# dependencies cloned by `ura install`, at any depth
dependencies/
# ura-computing repos, each its own git clone (see src/config.sh)
projects/
# the project `ura init` makes for trying things by hand
src/hello-world/
# generated by build in src/config.sh (machine-specific paths)
compile_commands.json
# the compiler and programs it builds
bin/
*.out
# test logs, like tests > build-tests.log
*.log
# scratch: drafts and manual tests
src/tmp.md
src/main.ura
# npm packages and compiled output of the vscode extension
node_modules/
_extension/out/
*.vsix
# Claude Code's machine-local settings (permissions, paths)
.claude/settings.local.json
