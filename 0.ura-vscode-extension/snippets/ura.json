{
  "function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) ${3:i32}:", "\t${0:return 0}"],
    "description": "A function"
  },
  "main": {
    "prefix": "main",
    "body": ["fn main() i32:", "\t${0}", "\treturn 0"],
    "description": "The program's entry point"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name}:", "\t${2:field} ${3:i32}${0}"],
    "description": "A struct with one attribute"
  },
  "method": {
    "prefix": "method",
    "body": ["fn ${1:name}(${2}) ${3:i32}:", "\t${0:return self.${4:field}}"],
    "description": "A method (inside a struct; self is the struct it's called on)"
  },
  "if": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "\t${0}"],
    "description": "if"
  },
  "if / elif / else": {
    "prefix": "ife",
    "body": ["if ${1:condition}:", "\t${2}", "elif ${3:condition}:", "\t${4}", "else:", "\t${0}"],
    "description": "if / elif / else"
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:condition}:", "\t${0}"],
    "description": "while loop"
  },
  "use": {
    "prefix": "use",
    "body": ["use \"${1:file}\""],
    "description": "Use another .ura file (path relative to this one, without .ura)"
  },
  "printf": {
    "prefix": "printf",
    "body": ["proto printf(fmt i8[], ...) i32"],
    "description": "Declare C's printf"
  }
}
